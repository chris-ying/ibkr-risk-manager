{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IBKR Risk Manager",
      "type": "shell",
      "command": "${workspaceFolder}/run_risk_manager_vscode.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
